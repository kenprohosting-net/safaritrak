# Reference values for the SAFARITRAK_* environment variables.
# Configure them in the PHP/Apache environment, or use backend/config/env.local.php.
SAFARITRAK_ENV=development
SAFARITRAK_DB_HOST=127.0.0.1
SAFARITRAK_DB_NAME=safaritrak
SAFARITRAK_DB_USER=safaritrak_app
SAFARITRAK_DB_PASS=replace-with-a-local-secret
SAFARITRAK_RATE_LIMIT_SECRET=replace-with-a-random-local-secret

SAFARITRAK_MAIL_HOST=smtp.example.test
SAFARITRAK_MAIL_PORT=587
SAFARITRAK_MAIL_USERNAME=
SAFARITRAK_MAIL_PASSWORD=
SAFARITRAK_MAIL_FROM=
SAFARITRAK_MAIL_FROM_NAME=SafariTrak

SAFARITRAK_APP_URL=http://localhost/safaritrak
SAFARITRAK_DEV_MODE=0

# Google Maps JavaScript API + Places API (New); restrict by API and HTTP referrer.
SAFARITRAK_GOOGLE_MAPS_API_KEY=
# Optional cloud-styled JavaScript Map ID; associate it with the published dark map style.
SAFARITRAK_GOOGLE_MAP_ID=
